# Leture 5.1 -- Containerizing Backend

# Build a docker image from Dockerfile

docker image build -t blog-backend backend/

# Create new docker 'network' - must grok

docker network create blog-net

# New docker mongodb for blog-net

docker run -d --name mongodb --network blog-net mongo:6.0.4

# Docker for something

docker run -it --name backend --network blog-net -e PORT=3001 -e DATABASE_URL=mongodb://mongodb:27017/blog -p 3001:3001 blog-backend

